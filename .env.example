# ─────────────────────────────────────────────────────────────────
# LifeOS — Environment Variables (example template)
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────────

# Runtime environment — "development", "test", or "production"
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
# Neon PostgreSQL pooled connection string (PgBouncer endpoint).
# From console.neon.tech → your project → "Pooled connection".
# MUST end with ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-cool-pooler.region.aws.neon.tech/lifeos?sslmode=require

# ── Better Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32

# Public app URL (where the app is served). Used by Better Auth for
# email verification links & cookie domain. Defaults to localhost.
BETTER_AUTH_URL=http://localhost:3000

# ── Public (client-bundled) ───────────────────────────────────────
# Safe to expose to the browser — prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth API base URL for the client. Omit unless running behind
# a proxy/CDN where auto-resolution fails. Must be an absolute URL.
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000/api/auth

# ── OAuth ───────────────────────────────────────────────────────
# Google OAuth credentials (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth credentials (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
