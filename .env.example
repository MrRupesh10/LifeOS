# LifeOS — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Required: none in Phase 1 (all have defaults)
# All variables validated in src/lib/config/env.ts

# Node environment (default: "development")
NODE_ENV=development

# Application URL (default: "http://localhost:3000")
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Phase 4: Database ──────────────────────────────────────────
# PostgreSQL connection string (Neon or local)
# Will be required in Phase 4.
# DATABASE_URL=postgresql://user:password@host:5432/lifeos

# ── Phase 3: Authentication ────────────────────────────────────
# Better Auth secret (generate: openssl rand -hex 32)
# Will be required in Phase 3.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# ── Phase 18: Email ────────────────────────────────────────────
# Email provider for password reset / notifications
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=